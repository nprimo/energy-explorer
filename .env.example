# E-REDES Balcão Digital credentials
# CPE code from your bill / portal (e.g. PT0002000012345678AB)
EREDES_CPE=PT0000000000000000XX

# aat cookie value from browser dev tools (Application > Cookies > balcaodigital.e-redes.pt)
# Bare token, "aat=..." or full Cookie header all accepted.
EREDES_AAT=

# Optional: OTLP/HTTP endpoint for tracing + logs export.
# Dev: run `docker compose up -d` and use http://localhost:4318 (Grafana UI at http://localhost:3000)
# Prod: point this at your OTel collector or vendor's OTLP/HTTP base URL.
# Unset = no exporter wired (spans recorded in-memory and dropped).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
