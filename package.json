    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3": "^7.4.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.4",
    "@types/node": "^26.1.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
